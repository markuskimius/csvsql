{
  "name": "Friendly Booleans",
  "version": "1.1.0",
  "author": "CSVSQL",
  "created": "2025-06-01",
  "description": "Show true/false as Yes/No. Use with customers.csv and products.csv (is_active column).",
  "tables": [
    {
      "table": ".*",
      "columns": [
        {
          "match": "^(active|enabled|verified|is_\\w+)$",
          "display": "choose(lower(value), '1', 'Yes', 'true', 'Yes', 'yes', 'Yes', '0', 'No', 'false', 'No', 'no', 'No')"
        }
      ]
    }
  ]
}
